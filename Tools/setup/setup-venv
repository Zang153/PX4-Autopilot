#!/usr/bin/env bash
set -euo pipefail

# Create the repository-local Python environment used by PX4's build tools.
# Operating-system packages and the compiler toolchain are installed separately
# by ubuntu.sh or macos.sh.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(git -C "$script_dir/../.." rev-parse --show-toplevel)"
venv_dir="${PX4_PYTHON_VENV:-$repo_root/.venv}"
python_exe="${PYTHON3:-python3}"

if [[ "$python_exe" == */* ]]; then
    [[ -x "$python_exe" ]] || {
        echo "Python executable not found: $python_exe" >&2
        exit 1
    }
elif ! command -v "$python_exe" >/dev/null 2>&1; then
    echo "Python executable not found: $python_exe" >&2
    exit 1
fi

if [[ -x "$venv_dir/bin/python" ]]; then
    "$python_exe" -m venv --upgrade "$venv_dir"
else
    "$python_exe" -m venv "$venv_dir"
fi

"$venv_dir/bin/python" -m pip install -r "$script_dir/requirements.txt"
"$venv_dir/bin/python" - <<'PY'
import importlib.metadata
import kconfiglib
import menuconfig
import sys

print(f"python={sys.executable}")
print(f"kconfiglib={importlib.metadata.version('kconfiglib')}")
print(f"menuconfig={menuconfig.__file__}")
PY

echo "PX4 Python environment ready: $venv_dir"
echo "Activate it before building:"
echo "  source $venv_dir/bin/activate"
echo "Then build with make, for example:"
echo "  make px4_sitl_default -j2"
