#!/bin/sh
#
# @name Gazebo Sunray 150 vision
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=sunray}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=sunray_150_vision}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Sunray 150: rotors at +-65 mm from CG, square-X (matches the vendor mesh
# and their Classic sim; the product page's 151 mm wheelbase conflicts with
# both and needs a real-airframe measurement).
# Layout matches the verified real aircraft (and PX4 quad-X):
# M1 front-right CCW, M2 rear-left CCW, M3 front-left CW, M4 rear-right CW.
param set-default CA_ROTOR0_PX 0.065
param set-default CA_ROTOR0_PY 0.065
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.065
param set-default CA_ROTOR1_PY -0.065
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.065
param set-default CA_ROTOR2_PY -0.065
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.065
param set-default CA_ROTOR3_PY 0.065
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# 1.08 kg takeoff mass with the calibrated motorConstant gives ~0.5 hover.
param set-default MPC_THR_HOVER 0.5
# The sim IMU runs at 500 Hz (clean 2 ms under gz-sim8's integer-ms sensor
# truncation). IMU_GYRO_RATEMAX has no 500 enum entry, so the PX4-side cap
# stays at the 400 default (the 500 Hz stream passes through), and companion
# policies must be launched with native_step_ratio=5 instead of auto-read.
param set-default NAV_DLL_ACT 2
