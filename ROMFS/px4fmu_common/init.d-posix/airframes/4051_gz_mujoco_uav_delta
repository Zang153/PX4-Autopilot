#!/bin/sh
# @name MuJoCo UAV Delta (Gazebo motor model)
# @type Quadrotor
. ${R}etc/init.d/rc.mc_defaults
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=mujoco_uav_delta}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=mujoco_uav_delta}
# Start close to the ground to reduce the initialization transient.
PX4_GZ_MODEL_POSE=${PX4_GZ_MODEL_POSE:=0,0,0.3,0,0,0}
param set-default SIM_GZ_EN 1
param set-default SIM_GZ_EN_ODOM 1
param set-default EKF2_EV_CTRL 15
param set-default EKF2_GPS_CTRL 0
param set-default EKF2_HGT_REF 3
param set-default COM_ARM_WO_GPS 1
param set-default COM_RC_IN_MODE 1
param set-default NAV_DLL_ACT 0
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
# MuJoCo FLU -> PX4 FRD: (x,y,z) -> (x,-y,-z).
# KM matches the official motor model's momentConstant.
param set-default CA_ROTOR0_PX 0.1414
param set-default CA_ROTOR0_PY 0.1414
param set-default CA_ROTOR0_KM 0.0230666667
param set-default CA_ROTOR1_PX -0.1414
param set-default CA_ROTOR1_PY -0.1414
param set-default CA_ROTOR1_KM 0.0230666667
param set-default CA_ROTOR2_PX 0.1414
param set-default CA_ROTOR2_PY -0.1414
param set-default CA_ROTOR2_KM -0.0230666667
param set-default CA_ROTOR3_PX -0.1414
param set-default CA_ROTOR3_PY 0.1414
param set-default CA_ROTOR3_KM -0.0230666667
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
# normalized u in [0,1] -> physical rotor speed command in rad/s.
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000
# Quadratic thrust estimate for 2.2508 kg and 39 N maximum total thrust.
param set-default MPC_THR_HOVER 0.752438
